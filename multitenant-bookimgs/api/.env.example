NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookimgs

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-at-least-32-random-characters-here
JWT_EXPIRES_IN=7d

# Email (Resend or SendGrid)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@bookimgs.app

# SMS - US (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# SMS - Ghana (Hubtel)
HUBTEL_CLIENT_ID=xxxxxxxx
HUBTEL_CLIENT_SECRET=xxxxxxxx
HUBTEL_FROM_NUMBER=BookImgs

# App base domain (for subdomain resolution)
APP_BASE_DOMAIN=localhost

# CORS — comma-separated allowed origins (subdomains of APP_BASE_DOMAIN are always allowed)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Object storage (for proof uploads — S3-compatible)
STORAGE_BUCKET=bookimgs-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
