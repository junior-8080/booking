{
  "expo": {
    "name": "Bookaata Business",
    "slug": "bookaata-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookaatabusiness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mukarocore.bookaatabusiness"
    },
    "android": {
      "package": "com.mukarocore.bookaatabusiness",
      "adaptiveIcon": {
        "backgroundColor": "#7c3565",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7c3565",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7c3565"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookaata Business needs access to your photos to attach a service or profile photo.",
          "cameraPermission": "Bookaata Business needs access to your camera to take a service or profile photo."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "916ae0b9-34c4-4051-a2c4-023df1e9f498"
      }
    },
    "owner": "mukarocore"
  }
}
